rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Non-admins cannot elevate their own role to admin
        request.auth.uid != userId ||
        request.resource.data.get('role', '') == resource.data.get('role', '') ||
        resource.data.get('role', '') in ["admin", "Administrator", "owner"] ||
        request.resource.data.get('role', '') != "admin"
      );
      allow delete: if isSignedIn();
    }

    match /patients/{patientId} {
      allow read, write: if isSignedIn();
    }

    match /consultations/{consultationId} {
      allow read, write: if isSignedIn();
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    match /activity/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /medicines/{medicineId} {
      allow read, write: if true;
    }

    match /clinicInvitations/{invitationId} {
      allow read, write: if isSignedIn();
    }

    match /doctorReceptionistMappings/{mappingId} {
      allow read, write: if isSignedIn();
    }

    match /clinic_assignments/{assignmentId} {
      allow read, write: if isSignedIn();
    }

    match /system/{document} {
      allow read, write: if true;
    }
  }
}

