rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Authentication & Access Control Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '').lower() in ["junaidudupi@gmail.com", "mohammedzaidd13@gmail.com", "admin.demo@meditrack.io"] ||
        (exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('authorizedRole', '') in ["admin", "Administrator"])
      );
    }

    function hasUserAccess() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('accountStatus', 'active') == 'active';
    }

    function getUserAccess() {
      return get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data;
    }

    function getUserClinic() {
      return getUserAccess().get('clinicId', '');
    }

    function isDoctor() {
      return hasUserAccess() && getUserAccess().get('authorizedRole', '') == 'doctor';
    }

    function isReceptionist() {
      return hasUserAccess() && getUserAccess().get('authorizedRole', '') == 'receptionist';
    }

    // ===============================================================
    // Collection: userAccess
    // ===============================================================
    match /userAccess/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ===============================================================
    // Collection: authorizedAccounts
    // ===============================================================
    match /authorizedAccounts/{emailKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.get('uid', request.auth.uid) == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // Collection: users
    // ===============================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection: clinics
    // ===============================================================
    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection: patients
    // ===============================================================
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (hasUserAccess() || isAdmin());
      allow update: if isSignedIn() && (hasUserAccess() || isAdmin());
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    // ===============================================================
    // Collection: consultations
    // ===============================================================
    match /consultations/{consultationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isDoctor() || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Collection: invoices
    // ===============================================================
    match /invoices/{invoiceId} {
      // Public read access for direct patient receipt links (?invoice=INV-...)
      allow read: if true;
      allow write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    // ===============================================================
    // Collections: payments, inventory, audit_logs, messages, activity
    // ===============================================================
    match /payments/{paymentId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    match /activity/{activityId} {
      allow read, write: if isSignedIn() && (hasUserAccess() || isAdmin());
    }

    // ===============================================================
    // Collections: medicines, system
    // ===============================================================
    match /medicines/{medicineId} {
      allow read, write: if true;
    }

    match /system/{document} {
      allow read, write: if true;
    }

    // ===============================================================
    // Collections: doctorReceptionistMappings, clinic_assignments, clinicInvitations
    // ===============================================================
    match /doctorReceptionistMappings/{mappingId} {
      allow read, write: if isSignedIn();
    }

    match /clinic_assignments/{assignmentId} {
      allow read, write: if isSignedIn();
    }

    match /clinicInvitations/{invitationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasUserAccess();
    }
  }
}
